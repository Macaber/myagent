{
  "name": "myagent",
  "version": "0.1.0",
  "description": "Long-running Agent Runtime with ACP protocol, Thread-Turn-Step telemetry, event-sourcing, and OpenAI compatibility",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "myagent": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "dev": "node --no-warnings dist/index.js",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "task": "node --experimental-strip-types scripts/run-task.ts"
  },
  "keywords": [
    "agent",
    "acp",
    "long-running",
    "llm",
    "openai",
    "node24"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
